<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_form_construction" model="ir.ui.view">
        <field name="name">stock.picking.form.construction</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="construction_project_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_stock_picking_list_construction" model="ir.ui.view">
        <field name="name">stock.picking.list.construction</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="construction_project_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_stock_picking_search_construction" model="ir.ui.view">
        <field name="name">stock.picking.search.construction</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="construction_project_id"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter name="construction_group_project" string="Project"
                        context="{'group_by': 'construction_project_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
